---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import AdSlot from '../components/AdSlot.astro';
import { SECTIONS, SITE_AUTHOR, SITE_AUTHOR_SLUG } from '../consts';
import { getRelatedPosts, heroUrl } from '../lib/posts';
import '../styles/global.css';

type Props = CollectionEntry<'blog'>['data'] & { hideMeta?: boolean; currentId?: string };
const { title, description, pubDate, updatedDate, heroImage, author, categories, hideMeta, currentId } =
	Astro.props;

// Resolve hero image — schema allows asset OR raw URL string
const hero =
	typeof heroImage === 'string'
		? heroImage
		: heroImage && typeof heroImage === 'object' && 'src' in heroImage
		? (heroImage as { src: string }).src
		: undefined;

// Map post's category slugs back to magazine sections (for the "Filed under" links)
const filed = (categories ?? [])
	.map((c) => SECTIONS.find((s) => (s.categories as readonly string[]).includes(c)))
	.filter(Boolean)
	.filter((v, i, a) => a.findIndex((x) => x?.slug === v?.slug) === i);

// Related stories: posts that share a category with this one. Only fetched
// when we have an id (i.e. we're rendering an actual blog post, not /about/).
const related =
	currentId && (categories ?? []).length > 0
		? await getRelatedPosts(currentId, categories ?? [], 4)
		: [];

// BreadcrumbList schema — helps Google understand site hierarchy.
const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://californiacurated.com/' },
		{ '@type': 'ListItem', position: 2, name: 'Articles', item: 'https://californiacurated.com/blog/' },
		{ '@type': 'ListItem', position: 3, name: title, item: new URL(Astro.url.pathname, Astro.site).toString() },
	],
};

// JSON-LD structured data for this article (NewsArticle schema).
// Helps Google show rich results with image, date, and author.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'NewsArticle',
	headline: title,
	description: description,
	url: canonicalURL,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: {
		'@type': 'Person',
		name: author ?? SITE_AUTHOR,
		url: `https://californiacurated.com/author/${SITE_AUTHOR_SLUG}/`,
	},
	publisher: {
		'@type': 'Organization',
		name: 'California Curated',
		url: 'https://californiacurated.com',
		logo: {
			'@type': 'ImageObject',
			url: 'https://californiacurated.com/icon-512.png',
		},
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': canonicalURL,
	},
	...(hero ? { image: { '@type': 'ImageObject', url: hero } } : {}),
};

// Link the author byline to their archive page when the name matches.
const authorHref = author === SITE_AUTHOR ? `/author/${SITE_AUTHOR_SLUG}/` : undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		{hero && <meta property="og:image" content={hero} />}
		<meta property="og:type" content="article" />
		<meta property="article:published_time" content={pubDate.toISOString()} />
		{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
		{hero && <link rel="preload" as="image" href={hero} />}
	</head>
	<body>
		<Header />
		<main>
			<article>
				{hero && (
					<div class="hero-wrap">
						<img src={hero} alt={title} class="hero" />
					</div>
				)}
				<div class="prose">
					<header class="post-head">
						{!hideMeta && (
							<p class="post-meta">
								<FormattedDate date={pubDate} />
								{author && (
									<> · By {authorHref ? <a href={authorHref}>{author}</a> : author}</>
								)}
							</p>
						)}
						<h1>{title}</h1>
						{description && <p class="lead">{description}</p>}
						{!hideMeta && updatedDate && (
							<p class="updated">Updated <FormattedDate date={updatedDate} /></p>
						)}
					</header>
					{!hideMeta && <hr />}
					<slot />
					<!-- In-article advertisement, placed after the body so it
					     never interrupts the reading flow. -->
					<AdSlot slot="8305126348" label="in-article" />
					{filed.length > 0 && (
						<footer class="post-footer">
							<p class="filed-under">
								Filed under: {filed.map((s, i) => s && (
									<>{i > 0 && ', '}<a href={`/category/${s.slug}/`}>{s.label}</a></>
								))}
							</p>
						</footer>
					)}
				</div>
			</article>
			{related.length > 0 && (
				<aside class="related-stories" aria-labelledby="related-stories-heading">
					<div class="related-inner">
						<h2 id="related-stories-heading">Keep reading</h2>
						<ul class="related-grid">
							{related.map((p) => (
								<li>
									<a href={`/blog/${p.id}/`}>
										{heroUrl(p) && <img src={heroUrl(p)} alt={p.data.title} loading="lazy" />}
										<h3>{p.data.title}</h3>
										<p class="related-meta"><FormattedDate date={p.data.pubDate} /></p>
									</a>
								</li>
							))}
						</ul>
					</div>
				</aside>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero-wrap {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 1.25rem 0;
	}
	.hero {
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: var(--cc-radius);
	}
	.post-head { padding: 2rem 0 1rem; }
	.post-head h1 {
		font-size: 2.6rem;
		margin: 0.5rem 0 1rem;
	}
	.post-meta {
		color: var(--cc-muted);
		font-size: 0.9rem;
		margin: 0;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.lead {
		font-size: 1.25rem;
		color: var(--cc-ink-soft);
		font-style: italic;
		margin: 0;
	}
	.updated {
		color: var(--cc-muted);
		font-size: 0.85rem;
	}
	.post-footer {
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--cc-line);
	}
	.filed-under { color: var(--cc-muted); font-size: 0.95rem; }
	.post-meta a { color: inherit; text-decoration: underline; text-decoration-color: var(--cc-line); }
	.post-meta a:hover { color: var(--cc-orange); }

	/* Related stories block — appears below the article, outside .prose so
	   the grid can use the full content width rather than the narrow body
	   column. */
	.related-stories {
		border-top: 1px solid var(--cc-line);
		margin-top: 4rem;
		padding: 3rem 0 1rem;
		background: var(--cc-bg-soft, #FAFAF8);
	}
	.related-inner {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 1.25rem;
	}
	.related-stories h2 {
		font-size: 1.4rem;
		font-family: "Helvetica Neue", Arial, sans-serif;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--cc-ink-soft);
		margin: 0 0 1.5rem;
	}
	.related-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
	}
	.related-grid a { display: block; color: var(--cc-ink); }
	.related-grid img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: var(--cc-radius);
		margin-bottom: 0.6rem;
	}
	.related-grid h3 {
		font-size: 1rem;
		margin: 0 0 0.3rem;
		line-height: 1.25;
	}
	.related-grid a:hover h3 { color: var(--cc-orange); }
	.related-meta { font-size: 0.85rem; color: var(--cc-muted); margin: 0; }
	@media (max-width: 900px) { .related-grid { grid-template-columns: 1fr 1fr; } }
	@media (max-width: 560px) { .related-grid { grid-template-columns: 1fr; } }

	@media (max-width: 720px) {
		.post-head h1 { font-size: 1.9rem; }
		.lead { font-size: 1.1rem; }
	}
</style>
