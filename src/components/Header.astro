---
import { SITE_TITLE, SITE_TAGLINE, SECTIONS, SITE_FACEBOOK, SITE_INSTAGRAM, SITE_TIKTOK } from '../consts';

const path = Astro.url.pathname;
function isActive(href: string) {
	if (href === '/') return path === '/';
	return path === href || path.startsWith(href + '/');
}
---

<header class="cc-header">
	<div class="cc-utility">
		<div class="container utility-row">
			<a href="/search" class="cc-icon-btn" aria-label="Search">
				<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
					<path fill="currentColor" d="M21 20l-5.6-5.6A8 8 0 1014 16.4l5.6 5.6L21 20zm-11-3a6 6 0 110-12 6 6 0 010 12z"/>
				</svg>
			</a>
			<div class="cc-socials" aria-label="Social media">
				{SITE_FACEBOOK && (
					<a href={SITE_FACEBOOK} class="cc-icon-btn" aria-label="California Curated on Facebook" target="_blank" rel="noopener noreferrer me">
						<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
							<path fill="currentColor" d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5H16.7V3.6c-.3 0-1.35-.1-2.55-.1-2.55 0-4.3 1.55-4.3 4.4v2H7.15v3.1h2.7V21h3.65z"/>
						</svg>
					</a>
				)}
				{SITE_INSTAGRAM && (
					<a href={SITE_INSTAGRAM} class="cc-icon-btn" aria-label="California Curated on Instagram" target="_blank" rel="noopener noreferrer me">
						<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
							<path fill="currentColor" d="M12 2.2c3.2 0 3.6 0 4.85.07 1.17.05 1.8.25 2.23.42.56.22.96.48 1.38.9.42.42.68.82.9 1.38.17.42.37 1.06.42 2.23.06 1.25.07 1.65.07 4.85s0 3.6-.07 4.85c-.05 1.17-.25 1.8-.42 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.17-1.06.37-2.23.42-1.25.06-1.65.07-4.85.07s-3.6 0-4.85-.07c-1.17-.05-1.8-.25-2.23-.42a3.7 3.7 0 01-1.38-.9 3.7 3.7 0 01-.9-1.38c-.17-.42-.37-1.06-.42-2.23C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.85c.05-1.17.25-1.8.42-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.17 1.06-.37 2.23-.42C8.4 2.2 8.8 2.2 12 2.2zm0 1.95c-3.14 0-3.51 0-4.75.07-1.07.05-1.65.23-2.04.38-.51.2-.88.44-1.27.83-.39.39-.63.76-.83 1.27-.15.39-.33.97-.38 2.04-.06 1.24-.07 1.61-.07 4.75s.01 3.51.07 4.75c.05 1.07.23 1.65.38 2.04.2.51.44.88.83 1.27.39.39.76.63 1.27.83.39.15.97.33 2.04.38 1.24.06 1.61.07 4.75.07s3.51 0 4.75-.07c1.07-.05 1.65-.23 2.04-.38.51-.2.88-.44 1.27-.83.39-.39.63-.76.83-1.27.15-.39.33-.97.38-2.04.06-1.24.07-1.61.07-4.75s0-3.51-.07-4.75c-.05-1.07-.23-1.65-.38-2.04a2.43 2.43 0 00-.83-1.27 2.43 2.43 0 00-1.27-.83c-.39-.15-.97-.33-2.04-.38C15.51 4.15 15.14 4.15 12 4.15zm0 3.32a4.53 4.53 0 110 9.06 4.53 4.53 0 010-9.06zm0 1.95a2.58 2.58 0 100 5.16 2.58 2.58 0 000-5.16zm5.78-2.17a1.06 1.06 0 11-2.12 0 1.06 1.06 0 012.12 0z"/>
						</svg>
					</a>
				)}
				{SITE_TIKTOK && (
					<a href={SITE_TIKTOK} class="cc-icon-btn" aria-label="California Curated on TikTok" target="_blank" rel="noopener noreferrer me">
						<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
							<path fill="currentColor" d="M19.6 6.7a5.4 5.4 0 01-3.3-1.1 5.4 5.4 0 01-2-3.5h-3.1v12.1a2.5 2.5 0 11-1.8-2.4V8.6a5.6 5.6 0 104.9 5.5V8.7a8.5 8.5 0 005.3 1.8V7.4c-.04 0-.04-.7 0-.7z"/>
						</svg>
					</a>
				)}
			</div>
			<div class="cc-utility-actions">
				<a href="https://ko-fi.com/californiacurated" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Donate</a>
				<a href="/contact" class="btn">Contact</a>
			</div>
		</div>
	</div>

	<div class="container cc-brand">
		<a href="/" class="cc-logo" aria-label={SITE_TITLE}>
			<img src="/californiacuratedtoplogo.jpg" alt={SITE_TITLE} class="cc-logo-img" />
		</a>
		<p class="cc-tagline">{SITE_TAGLINE}</p>
	</div>

	<nav class="cc-nav" aria-label="Sections">
		<div class="container cc-nav-row">
			<a href="/" class={isActive('/') ? 'active' : ''}>HOME</a>
			{SECTIONS.map(s => (
				<a href={`/category/${s.slug}/`}
					 class={isActive(`/category/${s.slug}`) ? 'active' : ''}>
					{s.label.toUpperCase()}
				</a>
			))}
		</div>
	</nav>
</header>

<style>
	.cc-header {
		background: #fff;
		border-bottom: 1px solid var(--cc-line);
	}

	.cc-utility {
		background: #1B1F23;
		color: #fff;
	}
	.utility-row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.6rem 1.25rem;
	}
	.cc-icon-btn {
		background: transparent;
		border: 0;
		color: #fff;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.35rem;
		border-radius: 4px;
	}
	.cc-icon-btn:hover { background: rgba(255,255,255,0.08); }
	.cc-socials {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		margin-left: 0.35rem;
		padding-left: 0.6rem;
		border-left: 1px solid rgba(255,255,255,0.15);
	}
	.cc-socials .cc-icon-btn { color: rgba(255,255,255,0.85); }
	.cc-socials .cc-icon-btn:hover { color: #fff; background: rgba(255,255,255,0.08); }
	.cc-utility-actions {
		margin-left: auto;
		display: flex;
		gap: 0.5rem;
	}
	.cc-utility-actions .btn {
		border-color: rgba(255,255,255,0.5);
		color: #fff;
		padding: 0.4em 1em;
		font-size: 0.95rem;
	}
	.cc-utility-actions .btn:hover { background: rgba(255,255,255,0.12); color: #fff; }
	.cc-utility-actions .btn-primary {
		background: var(--cc-blue);
		border-color: var(--cc-blue);
	}
	.cc-utility-actions .btn-primary:hover {
		background: var(--cc-blue-dark);
		border-color: var(--cc-blue-dark);
	}

	.cc-brand {
		text-align: center;
		padding: 1.6rem 1.25rem 1rem;
	}
	.cc-logo {
		display: inline-block;
		text-decoration: none;
		line-height: 1;
	}
	.cc-logo-img {
		display: block;
		width: auto;
		max-width: 380px;
		height: auto;
	}
	.cc-tagline {
		margin: 0.7rem 0 0;
		color: var(--cc-muted);
		font-style: italic;
		font-size: 1rem;
		letter-spacing: 0.01em;
	}

	.cc-nav {
		border-top: 1px solid var(--cc-line);
		border-bottom: 1px solid var(--cc-line);
	}
	.cc-nav-row {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.25rem 2rem;
		padding: 0.85rem 1.25rem;
		font-family: "Helvetica Neue", Arial, sans-serif;
		font-weight: 600;
		font-size: 0.85rem;
		letter-spacing: 0.07em;
	}
	.cc-nav-row a {
		color: var(--cc-ink-soft);
		padding: 0.25rem 0.1rem;
		border-bottom: 2px solid transparent;
	}
	.cc-nav-row a:hover { color: var(--cc-orange); }
	.cc-nav-row a.active {
		color: var(--cc-blue);
		border-bottom-color: var(--cc-blue);
	}

	@media (max-width: 720px) {
		.cc-utility-actions .btn { padding: 0.3em 0.7em; font-size: 0.85rem; }
		.cc-logo-img { max-width: 260px; }
		.cc-tagline { font-size: 0.85rem; }
		.cc-nav-row { gap: 0.5rem 1rem; font-size: 0.75rem; }
		.cc-socials { padding-left: 0.35rem; margin-left: 0.1rem; }
		.cc-socials .cc-icon-btn { padding: 0.3rem; }
		.cc-socials .cc-icon-btn svg { width: 18px; height: 18px; }
	}
</style>
