---
import Layout from '../layouts/BlogPost.astro';
---

<Layout
	title="Search"
	description="Search across every story on California Curated."
	pubDate={new Date('2026-05-01')}
	categories={[]}
	tags={[]}
	author="Erik Olsen"
	draft={false}
	hideMeta={true}
>
	<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
	<div id="search"></div>

	<script src="/pagefind/pagefind-ui.js" is:inline></script>
	<script is:inline>
		window.addEventListener('DOMContentLoaded', () => {
			new PagefindUI({
				element: '#search',
				showSubResults: true,
				showImages: true,
				resetStyles: false,
			});
		});
	</script>
</Layout>

<style is:global>
	/* Tweak Pagefind's default UI to fit California Curated's look */
	.pagefind-ui {
		--pagefind-ui-primary: var(--cc-blue);
		--pagefind-ui-text: var(--cc-ink);
		--pagefind-ui-background: #fff;
		--pagefind-ui-border: var(--cc-line);
		--pagefind-ui-tag: var(--cc-line-soft);
		--pagefind-ui-border-radius: var(--cc-radius);
		--pagefind-ui-image-border-radius: var(--cc-radius);
		--pagefind-ui-image-box-ratio: 4 / 3;
		--pagefind-ui-font: inherit;
		margin-top: 1.5rem;
	}
	.pagefind-ui__search-input {
		font-size: 1.05rem;
	}
	.pagefind-ui__result-title a:hover {
		color: var(--cc-orange);
	}
</style>
