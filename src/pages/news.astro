---
// Dedicated page that lists every curated news headline. Linked from the
// homepage rail's "See the full California news roundup" link and from
// the site footer.
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getItems, relativeTime, absoluteDate, news } from '../lib/news';

const items = getItems();
const lastUpdatedAbs = new Date(news.lastUpdated).toLocaleString('en-US', {
	month: 'short',
	day: 'numeric',
	year: 'numeric',
	hour: 'numeric',
	minute: '2-digit',
	timeZoneName: 'short',
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="California Science and Nature News"
			description="A curated roundup of California science, environment, and natural-history headlines from across the web. Refreshed every few hours."
		/>
	</head>
	<body>
		<Header />
		<main class="container news-page">
			<header class="news-page-head">
				<p class="kicker">A curated roundup</p>
				<h1>California Science and Nature News</h1>
				<p class="lede">
					Hand-picked stories from across California's science,
					environment, and natural-history beats. Refreshed every
					few hours.
				</p>
				<p class="updated">Last updated · {lastUpdatedAbs}</p>
			</header>

			<ul class="news-list">
				{items.map((it) => (
					<li class="news-item">
						<a href={it.url} target="_blank" rel="noopener noreferrer">
							<h3>{it.headline}</h3>
							<p class="source-line">
								<span class="source">{it.source}</span>
								<span class="sep">·</span>
								<span class="when-abs">{absoluteDate(it.publishedAt)}</span>
								<span class="sep">·</span>
								<span class="when-rel">{relativeTime(it.publishedAt)}</span>
							</p>
						</a>
					</li>
				))}
			</ul>

			<p class="legal">
				Sources curated by California Curated. Headlines remain the
				property of their original publishers.
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.news-page {
		max-width: 760px;
		margin: 0 auto;
		padding: 2.5rem 1.25rem 4rem;
	}
	.news-page-head {
		text-align: center;
		padding: 0 0 2rem;
		margin-bottom: 2rem;
		border-bottom: 1px solid var(--cc-line);
	}
	.news-page-head .kicker {
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--cc-muted);
		margin: 0;
	}
	.news-page-head h1 {
		font-size: 2.6rem;
		margin: 0.5rem 0 0.75rem;
		letter-spacing: -0.015em;
	}
	.news-page-head .lede {
		font-size: 1.1rem;
		color: var(--cc-ink-soft);
		max-width: 480px;
		margin: 0 auto 1rem;
		line-height: 1.55;
	}
	.news-page-head .updated {
		font-size: 0.8rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--cc-muted);
		margin: 0.5rem 0 0;
	}

	.news-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.news-item {
		padding: 1rem 0;
		border-top: 1px solid var(--cc-line);
	}
	.news-item:first-child { border-top: none; }
	.news-item a {
		display: block;
		color: var(--cc-ink);
		text-decoration: none;
	}
	.news-item a:hover h3 { color: var(--cc-orange); }
	.news-item h3 {
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.2rem;
		line-height: 1.35;
		margin: 0 0 0.4rem;
		font-weight: 600;
		letter-spacing: -0.005em;
	}
	.news-item .source-line {
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--cc-muted);
		margin: 0;
	}
	.news-item .source-line .sep {
		color: #c0c4cb;
		margin: 0 0.5em;
	}

	.legal {
		text-align: center;
		font-size: 0.78rem;
		color: var(--cc-muted);
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--cc-line);
		letter-spacing: 0.04em;
	}

	@media (max-width: 720px) {
		.news-page-head h1 { font-size: 2rem; }
		.news-item h3 { font-size: 1.05rem; }
	}
</style>
